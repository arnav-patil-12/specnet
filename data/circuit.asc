TEXT 640 32 Left 2 !.param W1=1.379e-3\n.param L1=1e-6\n.param W3=1.379e-3\n.param L3=1e-6\n.param W5=1.379e-3\n.param L5=1e-6\n\n.ac dec 100 1 1e12\n\n.meas AC gain_max MAX mag(V(Vo))\n.meas AC ugf WHEN db(V(Vo))=0 CROSS=1\n.meas AC phase_at_ugf FIND ph(V(Vo)) AT=ugf\n.meas AC pm PARAM phase_at_ugf + 180\n.meas AC gbw PARAM ugf
